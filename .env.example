# Copy to .env (never commit .env). All values below are placeholders.

# Public HTTPS origin of this server (no path). Must match DOMAIN for docker-compose.
PUBLIC_BASE_URL=https://tasks.example.com
DOMAIN=tasks.example.com

# Google Cloud OAuth client (type "Web application").
# Authorized redirect URI in Google Cloud must be: ${PUBLIC_BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Owner passphrase required on the consent page before linking (min. 16 chars).
# Generate with: openssl rand -base64 24
OWNER_PASSPHRASE=

# Redirect URIs that MCP clients may register (comma separated, exact match).
# Default is ChatGPT's connector redirect URI. If ChatGPT registration fails, the
# server log shows the rejected URI ("DCR rejected") - verify it and add it here.
ALLOWED_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect

# Time zone used to compute "urgent" (due today/tomorrow/overdue).
TIMEZONE=Europe/Bratislava

# Number of reverse proxies in front of the app (1 for the bundled Caddy).
TRUST_PROXY_HOPS=1

LOG_LEVEL=info

# Optional, outside Docker only:
# PORT=8080
# HOST=127.0.0.1
# DATABASE_PATH=./data/gtasks-mcp.sqlite
